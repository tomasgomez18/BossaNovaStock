# Copia este archivo a .env (desarrollo) o .env.production (producción)
# y reemplaza los valores <...> con los reales.

# ============ DESARROLLO (.env) ============
# Usa TU base de datos personal para hacer pruebas
PORT=5000
MONGO_URI=mongodb+srv://<TU_USUARIO>:<TU_PASSWORD>@<TU_CLUSTER>.mongodb.net/stockTienda_dev
JWT_SECRET=change_this_to_a_random_secret
ALLOWED_ORIGINS=http://localhost:5173
NODE_ENV=development
ADMIN_EMAIL=admin@tutienda.com
ADMIN_PASSWORD=tu_contraseña_segura
EMPLEADO_EMAIL=empleado@tutienda.com
EMPLEADO_PASSWORD=empleado123

# ============ MAIL (SMTP Brevo / Sendinblue) ============
# 1) Creá una cuenta gratis en https://brevo.com
# 2) En Settings > SMTP & API > SMTP Key, copiá tu SMTP Key (es MAIL_PASS)
# 3) Verificá el remitente en Settings > Senders & IP (el correo del FROM)
# 4) MAIL_USER es el email con el que te registraste en Brevo (NO el SMTP Key)
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_PORT=587
# MAIL_USER=tu_login_brevo@correo.com
# MAIL_PASS=tu_smtp_key_de_brevo
# MAIL_FROM="Tu Tienda" <remitente_verificado@correo.com>
# MAIL_TO=destinatario@correo.com

# ============ PRODUCCIÓN (.env.production) ============
# Usa LA base de datos del cliente (NO tocar en pruebas)
# MONGO_URI=mongodb+srv://<USUARIO_CLIENTE>:<PASSWORD_CLIENTE>@<CLUSTER_CLIENTE>.mongodb.net/stockTienda
# JWT_SECRET=otro_secreto_distinto
# ALLOWED_ORIGINS=https://tudominio.com
# NODE_ENV=production
# En Render: cargar las variables MAIL_* en Service > Environment (nunca commitearlas).
